# Servidor
PORT=3000

# Banco (opcional — sem isto, usa store em memória)
DATABASE_URL=postgres://postgres:postgres@db:5432/agente

# WhatsApp (deixe vazio no demo — o webhook aceita payload simulado)
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=demo

# LLM (opcional — sem chave, o agente usa fallback por FAQ)
# Suporta OpenAI OU Anthropic. Preencha um.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
